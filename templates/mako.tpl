# mako: Vesper glass notifications. Generated by wallcolors.py from templates/mako.tpl.
font=JetBrainsMono Nerd Font 11
background-color={{#glass:d9}}
text-color={{#text}}
border-color={{#accent:aa}}
border-size=1
border-radius=18
padding=14,16
margin=6,12
outer-margin=40,6,0,0
width=360
height=140
icons=1
max-icon-size=44
icon-border-radius=12
progress-color=over {{#accent:55}}
markup=1
actions=1
format=<b>%s</b>\n%b
group-by=app-name
default-timeout=5000
anchor=top-right
layer=overlay
max-history=25
max-visible=4

[urgency=low]
border-color={{#overlay:cc}}
default-timeout=3000

[urgency=high]
border-color={{#red}}
background-color={{#glass:f2}}
default-timeout=0

[summary~="^(Volume|Brightness)"]
default-timeout=1200
format=<b>%s</b>  %b

[mode=do-not-disturb]
invisible=1
