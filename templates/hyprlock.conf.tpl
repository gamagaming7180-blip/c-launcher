# hyprlock: Vesper. Blurred wallpaper, glass card, big clock, accent input pill.
# Generated by wallcolors.py from templates/hyprlock.conf.tpl.
general {
    hide_cursor = true
    grace = 0
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = ease, 0.16, 1, 0.3, 1
    animation = fadeIn, 1, 6, ease
    animation = fadeOut, 1, 4, ease
    animation = inputFieldDots, 1, 2, ease
}

background {
    monitor =
    path = {{lockbg}}
    blur_passes = 3
    blur_size = 7
    noise = 0.015
    contrast = 0.95
    brightness = 0.50
    vibrancy = 0.22
    vibrancy_darkness = 0.1
}

# glass card behind the clock
shape {
    monitor =
    size = 560, 300
    color = {{rgba(glass, 0.38)}}
    rounding = 44
    border_size = 1
    border_color = {{rgba(accent, 0.35)}}
    position = 0, 110
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:20000] echo "$(date +'%H:%M')"
    color = {{rgba(text, 1.0)}}
    font_size = 118
    font_family = JetBrainsMono Nerd Font ExtraBold
    position = 0, 150
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A  ·  %d %B')"
    color = {{rgba(accent, 1.0)}}
    font_size = 20
    font_family = JetBrainsMono Nerd Font
    position = 0, 52
    halign = center
    valign = center
}

label {
    monitor =
    text =   $USER
    color = {{rgba(subtext, 0.9)}}
    font_size = 14
    font_family = JetBrainsMono Nerd Font
    position = 0, 8
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 340, 56
    outline_thickness = 2
    dots_size = 0.24
    dots_spacing = 0.32
    dots_center = true
    outer_color = {{rgba(accent, 0.85)}}
    inner_color = {{rgba(island, 0.78)}}
    font_color = {{rgba(text, 1.0)}}
    fade_on_empty = true
    fade_timeout = 1500
    placeholder_text = <span foreground="##{{subtext}}">  Password</span>
    check_color = {{rgba(green, 1.0)}}
    fail_color = {{rgba(red, 1.0)}}
    capslock_color = {{rgba(yellow, 1.0)}}
    fail_text = <i>$FAIL</i>
    rounding = 28
    position = 0, -120
    halign = center
    valign = center
}
