# mako: event-driven, tiny. Catppuccin Mocha.
font=JetBrainsMono Nerd Font 11
background-color=#1e1e2ecc
text-color=#cdd6f4
border-color=#ef9faf
border-size=2
border-radius=12
padding=12
margin=10
width=340
height=120
icons=1
max-icon-size=40
default-timeout=5000
anchor=top-right
layer=overlay
max-history=20

[urgency=low]
border-color=#45475a
default-timeout=3000

[urgency=high]
border-color=#f38ba8
default-timeout=0

[mode=do-not-disturb]
invisible=1
