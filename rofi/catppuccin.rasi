/* Vesper list theme (dmenu, clipboard, window switcher, power menu, wallpaper picker).
   Generated by wallcolors.py from templates/rofi-list.rasi.tpl. Also installed as catppuccin.rasi for old scripts. */
* {
    base:     #1a140de0;
    field:    #f4efe612;
    line:     #f4efe61f;
    text:     #f4efe6;
    subtext:  #c0b5a5;
    accent:   #efcf9f;
    accent2:  #ddeb84;
    accent-b: #efcf9f99;
    pick:     #efcf9f38;

    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 12";
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 600px;
    background-color: @base;
    border: 1px;
    border-color: @accent-b;
    border-radius: 28px;
}

mainbox { padding: 18px; spacing: 12px; children: [ inputbar, listview ]; }

inputbar {
    padding: 12px 20px;
    spacing: 14px;
    background-color: @field;
    border: 1px;
    border-color: @line;
    border-radius: 22px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; vertical-align: 0.5; }
entry { placeholder: "Search"; placeholder-color: @subtext; vertical-align: 0.5; }

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 10px 16px;
    spacing: 14px;
    border: 1px;
    border-color: transparent;
    border-radius: 20px;
}
element selected.normal,
element selected.active { background-color: @pick; border-color: @accent-b; text-color: @text; }
element alternate.normal { background-color: transparent; }
element-icon { size: 28px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
