/* Vesper app grid: a touch-friendly launchpad for SUPER+SPACE. Generated by wallcolors.py. */
* {
    base:     #1a140dd8;
    field:    #f4efe612;
    line:     #f4efe61f;
    text:     #f4efe6;
    subtext:  #c0b5a5;
    accent:   #efcf9f;
    accent2:  #ddeb84;
    accent-b: #efcf9f99;
    pick:     #efcf9f30;

    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 11";
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 920px;
    background-color: @base;
    border: 1px;
    border-color: @accent-b;
    border-radius: 36px;
}

mainbox { padding: 30px; spacing: 22px; children: [ inputbar, listview ]; }

inputbar {
    padding: 14px 24px;
    spacing: 16px;
    background-color: @field;
    border: 1px;
    border-color: @line;
    border-radius: 26px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; vertical-align: 0.5; }
entry { placeholder: "Search apps"; placeholder-color: @subtext; vertical-align: 0.5; font: "JetBrainsMono Nerd Font 13"; }

listview {
    columns: 6;
    lines: 3;
    flow: horizontal;
    fixed-height: true;
    fixed-columns: true;
    scrollbar: false;
    spacing: 10px;
}

element {
    orientation: vertical;
    padding: 18px 6px 12px 6px;
    spacing: 10px;
    border: 1px;
    border-color: transparent;
    border-radius: 26px;
}
element selected.normal,
element selected.active { background-color: @pick; border-color: @accent-b; text-color: @text; }
element-icon { size: 64px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; vertical-align: 0.5; text-color: inherit; }
