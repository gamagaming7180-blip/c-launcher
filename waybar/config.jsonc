{
    // Floating, event-driven bar. Polling intervals are deliberately long.
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": ["hyprland/workspaces", "hyprland/window", "custom/media-equalizer"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "backlight", "network", "group/sys", "battery", "custom/screenrecord", "custom/power"],

    "custom/launcher": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "rofi -config ~/.config/hypr-rice/rofi/config.rasi -theme ~/.config/hypr-rice/rofi/catppuccin.rasi -show drun"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        "persistent-workspaces": { "*": 5 },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": { "": "Desktop", ".*[Cc]laude.*": "" }
    },

    "custom/media-equalizer": {
        "exec": "$HOME/.config/hypr-rice/scripts/media-equalizer.py",
        "return-type": "json",
        "restart-interval": 3,
        "hide-empty-text": true,
        "on-click": "$HOME/.config/hypr-rice/scripts/media-card.py",
        "tooltip": true,
        "escape": true,
        "max-length": 35
    },

    "clock": {
        "format": "{:%H:%M  ·  %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 30,
        "on-click": "~/.config/hypr-rice/scripts/panel-toggle.sh"
    },

    "tray": { "icon-size": 16, "spacing": 8 },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "backlight": {
        "format": "󰃠 {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format": "{essid}  {ipaddr}\n󰁅 {bandwidthDownBytes}  󰁝 {bandwidthUpBytes}",
        "on-click": "nm-connection-editor",
        "interval": 10
    },

    // CPU % and RAM used in GB, in one pill. Click either one for the full monitor.
    "group/sys": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory"]
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 5,
        "tooltip": false,
        "on-click": "~/.config/hypr-rice/scripts/sysmon-toggle.sh"
    },

    "memory": {
        "format": "󰍛 {used:0.1f}G",
        "interval": 10,
        "tooltip-format": "RAM  {used:0.1f} / {total:0.1f} GiB ({percentage}%)\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB\nAvailable {avail:0.1f} GiB\n\nClick for details",
        "on-click": "~/.config/hypr-rice/scripts/sysmon-toggle.sh"
    },

    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 30
    },

    "custom/screenrecord": {
        "format": "{text}",
        "exec": "$HOME/.config/hypr-rice/scripts/screen-record-toggle.sh status",
        "return-type": "json",
        "interval": 1,
        "on-click": "$HOME/.config/hypr-rice/scripts/screen-record-toggle.sh menu",
        "tooltip": true
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "$HOME/.config/hypr-rice/scripts/power-menu.sh"
    }
}
